.body("students.find { it.id == 456 }.name", equalTo("sumit"))
.body("students.find { it.id == 456 }.age", equalTo(96))
.body("students.find { it.id == 789 }.alive", is(true))


>> filtering
// Verify all students have id > 100
.body("students.id", everyItem(greaterThan(100)))
// Verify at least one student is alive
.body("students.alive", hasItem(true)))
// Verify no student has negative balance
.body("students.balance", everyItem(greaterThanOrEqualTo(0f)))

>> Array check
.body("Expense", contains(10, 20, 30, 40, 50, 60))  // Exact order
.body("Expense", hasItems(20, 40, 60))  // Contains these values
.body("Expense.min()", is(10))  // Minimum value
.body("Expense.max()", is(60))

>> Nested Object Validation
// Address validation
.body("addresses.state", equalTo("madhya pradesh"))
.body("addresses.city", equalToIgnoringCase("BURHANPUR"))  // Case insensitive

